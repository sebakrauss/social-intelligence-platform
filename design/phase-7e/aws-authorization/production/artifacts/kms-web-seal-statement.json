{
  "Sid": "WebSealOnly",
  "Effect": "Allow",
  "Principal": {
    "AWS": "<PROD_WEB_ROLE_ARN>"
  },
  "Action": "kms:GenerateDataKey",
  "Resource": "*",
  "Condition": {
    "StringEquals": {
      "kms:EncryptionContext:app": "social-intelligence-platform",
      "kms:EncryptionContext:purpose": "provider-credential",
      "kms:EncryptionContext:env": "prod",
      "kms:EncryptionContext:v": "1"
    },
    "StringLike": {
      "kms:EncryptionContext:workspace_id": "????????-????-????-????-????????????",
      "kms:EncryptionContext:credential_id": "????????-????-????-????-????????????"
    },
    "ForAllValues:StringEquals": {
      "kms:EncryptionContextKeys": [
        "app",
        "purpose",
        "env",
        "v",
        "workspace_id",
        "credential_id"
      ]
    }
  }
}
