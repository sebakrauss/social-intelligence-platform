# Public configuration names only — never put values in this file.
# Supabase Auth (public project URL and publishable key; no service-role or secret key is ever used by the app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Absolute public base URL of this app, used for email-link redirects (e.g. the sign-in link callback)
APP_BASE_URL=

# Database (Step 2). Names only — values live in .env.local (git-ignored) and in deployment secret stores.
# Runtime: each process gets ONLY its own URL — a dedicated long-lived login role through the Supavisor
# TRANSACTION pooler (port 6543, user <role>.<project-ref>). Never postgres, never a service-role key.
# A hosted WEB deployment gets DATABASE_WEB_URL only: it refuses to serve if the worker, system or migration URL
# (or another forbidden credential, see server/http/web-environment.ts) is present.
DATABASE_WEB_URL=
DATABASE_WORKER_URL=
DATABASE_SYSTEM_URL=
# The project's CA certificate (TLS is always verified for managed endpoints), in ONE of two forms:
# a filesystem path (local development: the git-ignored .local-certs/ file) …
DATABASE_SSL_ROOT_CERT=
# … or the PEM content itself (deployed workers, from the deployment's secret store; `\n` escapes accepted).
# When both are set the PEM content wins and the path is not read.
DATABASE_SSL_ROOT_CERT_PEM=
# Tooling only (migrations, role provisioning, managed tests) — never present in web/job runtimes.
DATABASE_MIGRATION_URL=
# The target project's reference; tooling refuses to touch any other project.
SUPABASE_PROJECT_REF=

# Jobs (Step 3): Trigger.dev, DEVELOPMENT environment only for local work. Names only — values live in
# .env.local and in the deployment's secret store. The web runtime needs TRIGGER_SECRET_KEY only to nudge the
# system relay after commit; the jobs deployment needs both. Never a production key in .env.local.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# Credential crypto (Step 5A): LOCAL/TEST ONLY local keyring KEK — exactly 32 random bytes as 43 unpadded
# base64url characters. No derivation, no default, no fallback: anything else fails closed, and it is refused
# unless NODE_ENV is "development" or "test". Deployed environments use AWS KMS (TA-Q-07), never this key.
LOCAL_KEYRING_KEY=

# Step 5D OAuth (web only): 32-byte key for stateless PKCE verifier derivation, 43-char unpadded base64url.
# Never logged, never persisted, never given to provider adapters or the job runtime. Value goes in .env.local only.
OAUTH_PKCE_DERIVATION_KEY=

# Step 5K job runtime provider composition. Unset: the local simulator rules (development/test only).
# staging_stub: a synthetic, I/O-free adapter for deployed NON-PRODUCTION validation — allowed only when
# APP_DEPLOYMENT_ENV is preview or staging (anything else, including production or unset, is refused).
APP_DEPLOYMENT_ENV=
CAPABILITY_PROVIDER_MODE=
