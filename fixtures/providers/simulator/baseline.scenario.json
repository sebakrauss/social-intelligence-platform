  "interactions": [
    { "id": "fb_c_001", "content": "fb_post_organic_01", "parent": null, "author": "fb_user_01", "text": "¿Cuánto sale el envío a Valparaíso?", "createdAt": "2026-09-10T16:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "fb_c_002", "content": "fb_post_organic_01", "parent": "fb_c_001", "author": "fb_author_aurora", "text": "¡Hola Camila! Depende del peso; te pasamos el detalle por aquí mismo.", "createdAt": "2026-09-10T16:30:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "fb_c_003", "content": "fb_post_organic_01", "parent": "fb_c_002", "author": "fb_user_01", "text": "Gracias, ¿y llega antes del viernes?", "createdAt": "2026-09-10T17:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "fb_c_004", "content": "fb_post_organic_01", "parent": null, "author": "fb_user_02", "text": "¿Tienen envío a Monterrey y Guadalajara? 🙏", "createdAt": "2026-09-10T18:00:00.000Z", "editedAt": "2026-09-11T08:00:00.000Z", "revision": "r2", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "fb_c_005", "content": "fb_post_organic_01", "parent": null, "author": "fb_user_03", "text": "Che, ¿cuándo vuelve a haber stock del de avellana?", "createdAt": "2026-09-10T19:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "fb_c_006", "content": "fb_post_organic_01", "parent": null, "author": "fb_user_04", "text": "Gana un premio aquí 👉 example.test/premio (sintético)", "createdAt": "2026-09-10T20:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "hidden", "presence": "present", "restrictions": [] },
    { "id": "fb_c_007", "content": "fb_post_organic_01", "parent": null, "author": "fb_user_02", "text": "Comentario retirado en la plataforma (sintético)", "createdAt": "2026-09-10T21:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "removed_signaled", "restrictions": [] },
    { "id": "fb_c_008", "content": "fb_post_organic_01", "parent": null, "author": "fb_user_03", "text": "Comentario que ya no devuelve la plataforma (sintético)", "createdAt": "2026-09-10T22:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "vanished", "restrictions": [] },
    { "id": "fb_c_010", "content": "fb_post_boosted_02", "parent": null, "author": "fb_user_01", "text": "Me encanta el color pero is it waterproof?", "createdAt": "2026-09-12T11:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": ["hide"] },
    { "id": "fb_c_011", "content": "fb_post_boosted_02", "parent": null, "author": "fb_user_02", "text": "¿El 2x1 aplica en todas las sucursales?", "createdAt": "2026-09-12T12:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "ig_c_001", "content": "ig_ad_only_10", "parent": null, "author": "ig_user_01", "text": "Vocês entregam em Recife? Quanto custa o frete?", "createdAt": "2026-09-08T13:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "ig_c_002", "content": "ig_ad_only_10", "parent": null, "author": "ig_user_02", "text": "Do you ship internationally?", "createdAt": "2026-09-08T14:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "ig_c_003", "content": "ig_ad_only_10", "parent": null, "author": "ig_user_01", "text": "Comprei ontem y todavía no llegó 😕", "createdAt": "2026-09-08T15:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "ig_c_010", "content": "ig_post_unknown_11", "parent": null, "author": "ig_user_03", "text": "Qué lindo el local, ¿dónde queda?", "createdAt": "2026-09-11T19:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "ig_c_020", "content": "ig_outlet_post_12", "parent": null, "author": "ig_user_02", "text": "Is the outlet open on Sundays?", "createdAt": "2026-09-09T13:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_001", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_01", "text": "Qual o nome da música? 🎶", "createdAt": "2026-09-07T21:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_002", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_02", "text": "¿Dónde compro esto en Lima?", "createdAt": "2026-09-07T21:10:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_003", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_03", "text": "This looks amazing, where can I get it?", "createdAt": "2026-09-07T21:20:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_004", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_04", "text": "Muito caro pra mim 😅", "createdAt": "2026-09-07T21:30:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_005", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_01", "text": "Fiz a receita e ficou ótima!", "createdAt": "2026-09-07T21:40:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_006", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_02", "text": "¿Sirve con leche de avena?", "createdAt": "2026-09-07T21:50:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_007", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_03", "text": "ok but what's the price en soles?", "createdAt": "2026-09-07T22:00:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_008", "content": "tt_video_multi_20", "parent": null, "author": "tt_user_04", "text": "Precio porfa 🙏", "createdAt": "2026-09-07T22:10:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] },
    { "id": "tt_c_009", "content": "tt_video_multi_20", "parent": "tt_c_002", "author": "tt_author_aurora", "text": "¡Hola! Estamos en Miraflores (sintético).", "createdAt": "2026-09-07T22:20:00.000Z", "editedAt": null, "revision": "r1", "visibility": "visible", "presence": "present", "restrictions": [] }
