# TA-Q-07b harness configuration. Names only — copy to .env.local (git-ignored) and fill in.
# Neither value is a credential: the harness signs in through the IAM Identity Center device flow and keeps
# every credential in memory only. Never put access keys, secret keys or session tokens in any file.

# AWS access portal URL of the IAM Identity Center organization instance
# (https://<id-or-alias>.awsapps.com/start or the dual-stack https://ssoins-<id>.portal.sa-east-1.app.aws)
TAQ07_SSO_START_URL=
# 12-digit ID of the dedicated development account; the harness refuses to run against any other account
TAQ07_EXPECTED_ACCOUNT_ID=
