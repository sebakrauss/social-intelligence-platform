# TEMPLATE ONLY — NO VALUES. Copy to `.env.local` in this folder (git-ignored) and fill in locally.
# Never paste these values into chat, docs, evidence or tracked files.
# Project: social-intelligence-dev (DEVELOPMENT / VALIDATION ONLY)

# Non-secret. Project Settings › General › Project ID  (e.g. abcdefghijklmnopqrst)
SUPABASE_PROJECT_REF=

# Non-secret. https://<project-ref>.supabase.co  (Connect dialog, or Project Settings › Data API)
SUPABASE_URL=

# Public / low privilege. Project Settings › API Keys › Publishable key (sb_publishable_…)
# Used to sign synthetic test users in and obtain REAL Supabase Auth access tokens.
SUPABASE_PUBLISHABLE_KEY=

# SECRET — TEST BOOTSTRAP ONLY (never runtime). Project Settings › API Keys › Secret keys (sb_secret_…)
# Used only to create and delete synthetic Auth test users via the Admin API.
SUPABASE_SECRET_KEY=

# SECRET — TEST BOOTSTRAP ONLY (never runtime). Connect (top bar) › "Session pooler" connection string (port 5432),
# with the real database password substituted for [YOUR-PASSWORD]. Format: postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
# Used only to create/drop the disposable validation schema and runtime test roles. The runtime tests then use
# Supavisor TRANSACTION mode (port 6543, same host) with randomly generated, in-memory-only role passwords.
SUPABASE_DB_BOOTSTRAP_URL=
